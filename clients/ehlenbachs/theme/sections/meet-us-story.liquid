{%- comment -%}
  Second viewport stub — place + Sissy tease. Bet 2 polishes.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.meet_us_story.heading_default' | t
  endif

  assign image_alt = section.settings.heading
  if image_alt == blank
    assign image_alt = 'Meet us in DeForest'
  endif
-%}

<section
  class="meet-us-story"
  data-meet-us-story
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="meet-us-story__inner">
    <h2 class="meet-us-story__heading">{{ heading | escape }}</h2>
    <hr
      class="meet-us-story__rule"
      style="background: {{ section.settings.accent_rule }};"
    >

    {%- if section.settings.story_image != blank -%}
      {%- capture story_image -%}
        {{
          section.settings.story_image
          | image_url: width: 1400
          | image_tag:
            class: 'meet-us-story__image',
            loading: 'lazy',
            widths: '600, 900, 1400',
            alt: image_alt
        }}
      {%- endcapture -%}

      {%- if section.settings.image_link != blank -%}
        <a href="{{ section.settings.image_link }}">
          {{ story_image }}
        </a>
      {%- else -%}
        {{ story_image }}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Meet Us Story",
  "tag": "section",
  "class": "section-meet-us-story",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#D4B896",
      "info": "Light wood grain stand-in until photo is set"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet us in DeForest"
    },
    {
      "type": "color",
      "id": "accent_rule",
      "label": "Accent rule",
      "default": "#8B2E2E",
      "info": "Barn red — sparse"
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story image",
      "info": "Sissy + chalet exterior"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image link (optional)"
    }
  ],
  "presets": [
    {
      "name": "Meet Us Story"
    }
  ]
}
{% endschema %}
