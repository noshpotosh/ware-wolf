{%- comment -%}
  Minimal cart drawer. Heat / ice-pack notes may live here later —
  never in the homepage hero.
{%- endcomment -%}

<div
  class="cart-drawer"
  id="CartDrawer"
  data-cart-drawer
  hidden
>
  <div
    class="cart-drawer__overlay"
    data-cart-close
    aria-hidden="true"
  ></div>

  <aside
    class="cart-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="CartDrawerTitle"
  >
    <button
      type="button"
      class="cart-drawer__close"
      data-cart-close
    >
      {{ 'general.accessibility.close' | t }}
    </button>

    <h2 class="cart-drawer__title" id="CartDrawerTitle">
      {{ 'cart.title' | t }}
    </h2>

    {%- if cart.item_count == 0 -%}
      <p class="cart-drawer__empty">{{ 'cart.empty' | t }}</p>
    {%- else -%}
      <ul class="cart-drawer__items">
        {%- for item in cart.items -%}
          <li>
            {{ item.product.title | escape }}
            × {{ item.quantity }}
            — {{ item.final_line_price | money }}
          </li>
        {%- endfor -%}
      </ul>

      <p class="cart-drawer__note">
        {{ 'cart.shipping_note' | t }}
      </p>

      <p>
        <strong>Subtotal:</strong>
        {{ cart.total_price | money }}
      </p>

      <a
        class="cart-drawer__checkout"
        href="{{ routes.cart_url }}"
      >
        {{ 'cart.checkout' | t }}
      </a>
    {%- endif -%}
  </aside>
</div>
