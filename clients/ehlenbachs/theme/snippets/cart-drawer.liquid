{%- comment -%}
  Cart drawer opened from the header. Quantity changes happen on the
  cart page; the drawer lists items and links onward.
{%- endcomment -%}

<div
  class="cart-drawer"
  id="CartDrawer"
  data-cart-drawer
  hidden
>
  <div
    class="cart-drawer__overlay"
    data-cart-close
    aria-hidden="true"
  ></div>

  <aside
    class="cart-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="CartDrawerTitle"
  >
    <button
      type="button"
      class="cart-drawer__close"
      data-cart-close
    >
      {{ 'general.accessibility.close' | t }}
    </button>

    <h2 class="cart-drawer__title" id="CartDrawerTitle">
      {{ 'cart.title' | t }}
    </h2>

    {%- if cart.item_count == 0 -%}
      <p class="cart-drawer__empty">{{ 'cart.empty' | t }}</p>
    {%- else -%}
      <ul class="cart-drawer__items">
        {%- for item in cart.items -%}
          <li class="cart-drawer__item">
            <div class="cart-drawer__media">
              {%- if item.image != blank -%}
                {{
                  item.image
                  | image_url: width: 160
                  | image_tag: loading: 'lazy', alt: item.product.title
                }}
              {%- endif -%}
            </div>
            <div>
              <a class="cart-drawer__item-title" href="{{ item.url }}">
                {{ item.product.title | escape }}
              </a>
              <p class="cart-drawer__item-meta">
                {%- unless item.product.has_only_default_variant -%}
                  {{ item.variant.title | escape }} ·
                {%- endunless %}
                Qty {{ item.quantity }} · {{ item.final_line_price | money }}
              </p>
              <a class="cart-drawer__remove" href="{{ item.url_to_remove }}">
                {{ 'cart.remove' | t }}
                <span class="visually-hidden">{{ item.product.title | escape }}</span>
              </a>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <p class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <span>{{ cart.total_price | money }}</span>
      </p>

      <p class="cart-drawer__note">
        {{ 'cart.shipping_note' | t }}
      </p>

      <form action="{{ routes.cart_url }}" method="post">
        <button class="cart-drawer__checkout" type="submit" name="checkout">
          {{ 'cart.checkout' | t }}
        </button>
      </form>
      <a class="cart-drawer__view-cart" href="{{ routes.cart_url }}">
        {{ 'cart.view_cart' | t }}
      </a>
    {%- endif -%}
  </aside>
</div>
