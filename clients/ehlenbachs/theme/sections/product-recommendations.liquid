{%- liquid
  if section.settings.source == 'category'
    capture category_handle
      render 'product-category-handle', product: product, current_collection: collection
    endcapture
    assign category = collections[category_handle]
    assign related_products = category.products
    assign heading = section.settings.heading | replace: '[category]', category.title
  else
    assign related_products = collections.all.products
    if section.settings.fallback_collection != blank
      assign related_products = section.settings.fallback_collection.products
    endif
    if recommendations.performed? and recommendations.products_count > 0
      assign related_products = recommendations.products
    endif
    assign heading = section.settings.heading
  endif
-%}

{%- capture recommendation_cards -%}
  {%- assign rendered_count = 0 -%}
  {%- for related_product in related_products -%}
    {%- if related_product.id == product.id -%}
      {%- continue -%}
    {%- endif -%}
    {% render 'product-card', product: related_product %}
    {%- assign rendered_count = rendered_count | plus: 1 -%}
    {%- if rendered_count >= section.settings.products_to_show -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if section.settings.source == 'related' -%}
{%- capture recommendation_url -%}
  {{ routes.product_recommendations_url }}
  ?section_id={{ section.id }}
  &product_id={{ product.id }}
  &limit={{ section.settings.products_to_show }}
  &intent=related
{%- endcapture -%}
{%- endif -%}

<section
  class="product-recommendations"
  data-product-recommendations
  {% if recommendation_url != blank %}
    data-url="{{ recommendation_url | strip_newlines | remove: ' ' }}"
  {% endif %}
  {% if recommendation_cards == blank %}hidden{% endif %}
>
  {%- if recommendation_cards != blank -%}
    <div class="product-recommendations__inner">
      <div class="product-recommendations__heading-row">
        <h2>{{ heading | escape }}</h2>
        {%- if category != blank -%}
          <a href="{{ category.url }}">Shop {{ category.title | escape }}</a>
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}">Shop all</a>
        {%- endif -%}
      </div>

      <div class="product-grid">
        {{ recommendation_cards }}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Products",
      "options": [
        { "value": "related", "label": "Shopify recommendations" },
        { "value": "category", "label": "Same category" }
      ],
      "default": "related"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "[category] is replaced with the product's category name.",
      "default": "More from the cheese counter"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback collection",
      "info": "Shopify recommendations only. Shown until they load, or when none are available. Defaults to all products."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
