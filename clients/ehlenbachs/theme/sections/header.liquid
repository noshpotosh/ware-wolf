{%- comment -%}
  Transparent over full-bleed heroes; solid wood on cream pages.
  Hours and shipping stay out of this chrome.
{%- endcomment -%}

{%- liquid
  assign overlay_mode = section.settings.overlay_mode
  assign brand_text = section.settings.brand_text
  if brand_text == blank
    assign brand_text = shop.name
  endif
-%}

<header
  class="site-header site-header--{{ overlay_mode }}"
  role="banner"
  data-header
>
  <div class="site-header__inner">
    <a class="site-header__brand" href="{{ routes.root_url }}">
      {%- if section.settings.brand_image != blank -%}
        {%- liquid
          assign brand_alt = section.settings.brand_image_alt
          if brand_alt == blank
            assign brand_alt = brand_text
          endif
        -%}
        {{
          section.settings.brand_image
          | image_url: width: 360
          | image_tag:
            class: 'site-header__brand-image',
            alt: brand_alt,
            loading: 'eager'
        }}
      {%- else -%}
        {{ brand_text }}
      {%- endif -%}
    </a>

    <div class="site-header__utilities">
      <button
        type="button"
        class="site-header__menu-toggle"
        data-menu-toggle
        aria-controls="PrimaryNavigation"
        aria-expanded="false"
      >
        <span data-menu-label>Menu</span>
      </button>

      {%- if section.settings.show_cart_icon -%}
        <button
          type="button"
          class="site-header__cart site-header__cart--mobile"
          data-cart-open
          aria-controls="CartDrawer"
          aria-expanded="false"
        >
          <svg
            class="site-header__cart-icon"
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
          >
            <path d="M3 4h2l2.2 10.2h10.9L21 7H6"></path>
            <circle cx="9" cy="19" r="1.25"></circle>
            <circle cx="18" cy="19" r="1.25"></circle>
          </svg>
          <span class="visually-hidden">
            {{ 'sections.header.cart' | t }}
          </span>
          <span class="site-header__cart-count" data-cart-count>
            {{ cart.item_count }}
          </span>
        </button>
      {%- endif -%}
    </div>

    <nav
      class="site-header__navigation"
      id="PrimaryNavigation"
      aria-label="Primary"
      data-primary-navigation
    >
      <ul class="site-header__nav">
        {%- if section.settings.menu != blank -%}
          {%- for link in section.settings.menu.links -%}
            <li>
              <a
                href="{{ link.url }}"
                {% if link.active %}
                  aria-current="page"
                {% endif %}
              >
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li>
            <a href="{{ routes.all_products_collection_url }}">
              Shop
            </a>
          </li>
          <li>
            <a href="/pages/visit">Visit Us</a>
          </li>
        {%- endif -%}

        {%- liquid
          assign careers_url = section.settings.careers_url
          if careers_url == blank
            assign careers_url = pages['careers'].url
          endif
          assign careers_in_menu = false
          for link in section.settings.menu.links
            if link.url == careers_url
              assign careers_in_menu = true
            endif
          endfor
        -%}
        {%- if section.settings.show_careers_link
          and careers_url != blank
          and careers_in_menu == false
        -%}
          <li>
            <a
              href="{{ careers_url | escape }}"
              {% if page.handle == 'careers' %}
                aria-current="page"
              {% endif %}
            >
              {{ section.settings.careers_label | escape }}
            </a>
          </li>
        {%- endif -%}

        {%- if section.settings.show_cart_icon -%}
          <li class="site-header__cart-item">
            <button
              type="button"
              class="site-header__cart"
              data-cart-open
              aria-controls="CartDrawer"
              aria-expanded="false"
            >
              {{ 'sections.header.cart' | t }}
              <span
                class="site-header__cart-count"
                data-cart-count
              >
                {{ cart.item_count }}
              </span>
            </button>
          </li>
        {%- endif -%}
      </ul>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "brand_image",
      "label": "Brand wordmark"
    },
    {
      "type": "text",
      "id": "brand_image_alt",
      "label": "Brand wordmark alt text",
      "default": "Ehlenbach's Cheese Chalet"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text (if no image)",
      "default": "Ehlenbach's Cheese Chalet"
    },
    {
      "type": "select",
      "id": "overlay_mode",
      "label": "Overlay mode",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent (over heroes)"
        },
        {
          "value": "solid-wood",
          "label": "Solid wood (cream pages)"
        }
      ],
      "default": "transparent"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "info": "Shop · Gift Baskets? · Visit Us. Cart is separate."
    },
    {
      "type": "checkbox",
      "id": "show_cart_icon",
      "label": "Show cart control",
      "default": true
    },
    {
      "type": "header",
      "content": "Careers link"
    },
    {
      "type": "checkbox",
      "id": "show_careers_link",
      "label": "Show careers link",
      "default": true
    },
    {
      "type": "text",
      "id": "careers_label",
      "label": "Careers link label",
      "default": "Work with us"
    },
    {
      "type": "url",
      "id": "careers_url",
      "label": "Careers page",
      "info": "Defaults to the page with the handle careers. The link is hidden until that page exists."
    }
  ]
}
{% endschema %}
