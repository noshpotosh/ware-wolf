<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    >
    <title>
      {{ page_title }}
      {%- if current_tags -%}
        &ndash; tagged "{{ current_tags | join: ', ' }}"
      {%- endif -%}
      {%- if current_page != 1 -%}
        &ndash; Page {{ current_page }}
      {%- endif -%}
      {%- unless page_title contains shop.name -%}
        &ndash; {{ shop.name }}
      {%- endunless -%}
    </title>

    {% if page_description %}
      <meta
        name="description"
        content="{{ page_description | escape }}"
      >
    {% endif %}

    <link rel="canonical" href="{{ canonical_url }}">

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'home.css' | asset_url | stylesheet_tag }}
    {{ 'shop.css' | asset_url | stylesheet_tag }}
    {{ 'visit.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <script>
      document.documentElement.className =
        document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body
    class="template-{{ template.name }}
      {%- if template.suffix -%}
        template-{{ template.name }}-{{ template.suffix }}
      {%- endif -%}"
  >
    <a class="visually-hidden" href="#MainContent">
      {{ 'general.accessibility.skip_to_content' | t }}
    </a>

    {%- comment -%}
      Order from liquid map: Header → Announcement (optional)
      → main → Footer → Cart Drawer. Hours/shipping never in hero.
    {%- endcomment -%}
    {% section 'header' %}
    {% section 'announcement-banner' %}

    <main id="MainContent" class="site-main" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    {% render 'cart-drawer' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
