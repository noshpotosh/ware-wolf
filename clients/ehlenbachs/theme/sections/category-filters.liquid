<nav class="category-filters" aria-label="Shop categories">
  <div class="category-filters__scroller">
    {%- if section.settings.menu != blank -%}
      {%- for link in section.settings.menu.links -%}
        <a
          class="category-filters__link"
          href="{{ link.url }}"
          {% if link.active %}aria-current="page"{% endif %}
        >
          {{ link.title | escape }}
        </a>
      {%- endfor -%}
    {%- else -%}
      <a
        class="category-filters__link"
        href="{{ routes.all_products_collection_url }}"
        {% if collection.handle == 'all' %}aria-current="page"{% endif %}
      >
        All products
      </a>
      {%- liquid
        assign browse_collections = section.settings.collections
        if browse_collections == blank
          assign browse_collections = collections
        endif
      -%}
      {%- for category in browse_collections -%}
        {%- if category.handle == 'all' or category.all_products_count == 0 -%}
          {%- continue -%}
        {%- endif -%}
        <a
          class="category-filters__link"
          href="{{ category.url }}"
          {% if collection.id == category.id %}aria-current="page"{% endif %}
        >
          {{ category.title | escape }}
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</nav>

{% schema %}
{
  "name": "Category Filters",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Filter menu",
      "info": "Use direct collection links in display order."
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Featured categories",
      "limit": 8,
      "info": "Used without a menu. Defaults to your store collections."
    }
  ],
  "presets": [
    {
      "name": "Category Filters"
    }
  ]
}
{% endschema %}
