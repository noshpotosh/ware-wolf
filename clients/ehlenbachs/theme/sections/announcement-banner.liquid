{%- comment -%}
  Slim strip under the header. Default off — seasonal only.
  Never place this above the brand or inside a hero.
{%- endcomment -%}

{%- if section.settings.enable
  and section.settings.message != blank
-%}
  <aside
    class="announcement-banner"
    role="status"
    data-announcement-banner
  >
    <div class="announcement-banner__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">
          {{ section.settings.message | escape }}
        </a>
      {%- else -%}
        {{ section.settings.message | escape }}
      {%- endif -%}
    </div>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Announcement banner",
  "class": "section-announcement-banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable banner",
      "default": false,
      "info": "Keep off unless seasonal (holiday hours, heat)."
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link",
      "info": "e.g. Shipping notes page"
    }
  ]
}
{% endschema %}
